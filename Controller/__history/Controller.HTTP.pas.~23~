unit Controller.HTTP;

interface

uses DownloadApp.Types, Controller.Interfaces,
     Model.Interfaces, Model.HTTP;

type

  TControllerIdHTTP = class(TInterfacedObject, IControllerIdHTTP)

  private
    { Private declarations }
    FModelIdHTTP: IModelHTTP;

  public
    // Construtor da classe.
    constructor Create;

    // Destrutor da classe.
    destructor Destroy; override;

    // Método responsável por criar uma nova instância do objeto.
    // Uma class function permite que o método possa ser chamado a partir da própria classe, sem a necessidade de se instanciar um objeto dela.
    class function New: IControllerIdHTTP;

    // Método responsável por realizar o download do arquivo.
    procedure StartDownload(url, destiny: String);

    // Método responsável por parar o download do arquivo.
    procedure StopDownload;

    // Método responsável por retornar se existe algum donwload em andamento.
    function IsDownloading: Boolean;

    procedure AddObserver(Observer: IDownloadObserver);
  end;

implementation

{ TControllerIdHTTP }

procedure TControllerIdHTTP.AddObserver(Observer: IDownloadObserver);
begin
  FModelIdHTTP.GetObserver.AddObserver(Observer);
end;

constructor TControllerIdHTTP.Create;
begin
  FModelIdHTTP := TModelHTTP.New;
end;

destructor TControllerIdHTTP.Destroy;
begin
  inherited;
end;

function TControllerIdHTTP.IsDownloading: Boolean;
begin
  Result := FModelIdHTTP.IsDownloading;
end;

procedure TControllerIdHTTP.StartDownload(url, destiny: String);
begin
  FModelIdHTTP.StartDownload(url, destiny);
end;

class function TControllerIdHTTP.New: IControllerIdHTTP;
begin
  result := Self.Create;
end;

procedure TControllerIdHTTP.StopDownload;
begin
  FModelIdHTTP.StopDownload;
end;

end.


