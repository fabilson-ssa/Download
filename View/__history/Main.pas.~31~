unit Main;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants,
  System.Classes, Vcl.Graphics, Vcl.Controls, Vcl.Forms, Vcl.Dialogs,
  Vcl.ExtCtrls, Vcl.StdCtrls, Vcl.ComCtrls, Vcl.Imaging.pngimage,
  Vcl.Buttons, Vcl.FileCtrl,
  System.IOUtils,
  Controller.Interfaces,
  DownloadApp.Types,
  Controller.HTTP,
  ExceptionHandler;

type
  TMainForm = class(TForm, iDownloadObserver)
    gpFundo: TGridPanel;
    pnTop: TPanel;
    pnFundo: TPanel;
    pnRodape: TPanel;
    GridPanel1: TGridPanel;
    Label1: TLabel;
    edURL: TEdit;
    Label2: TLabel;
    edDestino: TEdit;
    GridPanel2: TGridPanel;
    btIniciar: TButton;
    btParar: TButton;
    GridPanel3: TGridPanel;
    pbProgresso: TProgressBar;
    imLogo: TImage;
    GridPanel4: TGridPanel;
    lbPercentual: TLabel;
    lbKiloBytes: TLabel;
    sbSelecionarDiretorio: TSpeedButton;
    SaveDialog: TSaveDialog;
    GridPanel5: TGridPanel;
    Image1: TImage;
    Label3: TLabel;
    procedure FormCreate(Sender: TObject);
    procedure btIniciarClick(Sender: TObject);
    procedure btPararClick(Sender: TObject);
    procedure sbSelecionarDiretorioClick(Sender: TObject);
    procedure Image1Click(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
  private
    { Private declarations }
    ControllerIdHTTP: iControllerIdHTTP;

    procedure CarregarDadosNaTela(ResultadoDownload: TDownloadRecord);
    procedure FinalizarComSucesso;
    procedure ReiniciarControles;
    procedure FinalizarComErro(DownloadRecord: TDownloadRecord);
    procedure FinalizadoPeloUsuario(ResultadoDownload: TDownloadRecord);

    // Método responsável por habilitar/desabilitar componentes de tela.
    procedure EnableComponents(enable: Boolean);
  public
    { Public declarations }
    procedure Atualizar(ResultadoDownload: TDownloadRecord);
    procedure WMGetMinMaxInfo(var MSG: TMessage); message WM_GetMinMaxInfo;
  end;

var
  MainForm: TMainForm;

implementation

{$R *.dfm}

//uses Download.View.Historico;

{ TMain }

procedure TMainForm.FormCreate(Sender: TObject);
begin
  // Criação do objeto responsável pelo controle de "observação" do download.
  ControllerIdHTTP := TControllerIdHTTP.New;

  ControllerIdHTTP.AddObserver(Self);
end;

procedure TMainForm.FormClose(Sender: TObject; var Action: TCloseAction);
begin
  // Antes de finalizar, verifica se ainda existe algum download em andamento.
  if ControllerIdHTTP.IsDownloading then
    begin
      // Verifica se o usuário deseja realmente interromper o download.
      if MessageBox(0, PChar('Ainda existe download em andamento.'+#13+#10+'Confirma a interrupção?'), PChar('Atenção'), MB_ICONQUESTION or MB_OK or MB_SYSTEMMODAL) = mrYes then
        begin
          btParar.Click;
        end
      else
        Abort;
    end;
end;

procedure TMainForm.btIniciarClick(Sender: TObject);
var file_name: String;
begin
  file_name := System.IOUtils.TPath.GetFileName(edURL.Text);
  edDestino.Text := System.IOUtils.TPath.Combine(edDestino.Text, file_name);

//  edDestino.Text := ChangeFileExt(edDestino.Text, ExtractFileExt(edURL.Text));

  btIniciar.Enabled := False;
  pbProgresso.Visible := True;

  // Inicializa o download do arquivo.
  ControllerIdHTTP.StartDownload(edURL.Text, edDestino.Text);
end;

procedure TMainForm.btPararClick(Sender: TObject);
var
  ResDownload: TDownloadRecord;
begin
  ControllerIdHTTP.StopDownload;
end;

{*********************************************************}
{ Método do padrão observer que será chamado pelo subject }
{*********************************************************}
procedure TMainForm.Atualizar(ResultadoDownload: TDownloadRecord);
begin
  case ResultadoDownload.Status of
    stSuccess: FinalizarComSucesso;
    stFinished: FinalizarComErro(ResultadoDownload);
    stDownloading: CarregarDadosNaTela(ResultadoDownload);
  end;
end;

procedure TMainForm.FinalizarComSucesso;
begin
  MessageBox(0, PChar('Download realizado com sucesso'), PChar('Atenção'), MB_ICONINFORMATION or MB_OK);

  EnableComponents(True);
end;

procedure TMainForm.FinalizarComErro(DownloadRecord: TDownloadRecord);
begin
  ReiniciarControles;

//  ShowMessage('Processo Cancelado!' + sLineBreak + ResultadoDownload.MsgErro);

  MessageBox(0, PChar('Problema ao realizar o download'+#13+#10+ DownloadRecord.ErrorMessage), PChar('Atenção'), MB_ICONERROR or MB_OK);
end;

procedure TMainForm.FinalizadoPeloUsuario(ResultadoDownload: TDownloadRecord);
begin
  ReiniciarControles;
  ShowMessage('Processo Cancelado Pelo Usuário!');
  EnableComponents(True);
end;

procedure TMainForm.EnableComponents(enable: Boolean);
begin
  btIniciar.Enabled := enable;
  btParar.Enabled := not enable;
end;

procedure TMainForm.Image1Click(Sender: TObject);
begin
//  Application.CreateForm(TfmHistorico, fmHistorico);
//  try
//    fmHistorico.ShowModal;
//  finally
//    FreeAndNil(fmHistorico);
//  end;
end;

procedure TMainForm.ReiniciarControles;
begin
  pbProgresso.Visible := False;
  lbPercentual.Visible := False;
  lbKiloBytes.Visible := False;

  pbProgresso.Position := 0;
  pbProgresso.Max := 0;
  lbPercentual.Caption := '0 %';
  lbKiloBytes.Caption := '0 Kb';

  EnableComponents(True);
end;

procedure TMainForm.sbSelecionarDiretorioClick(Sender: TObject);
var selDir: String;
begin
  SaveDialog.Filter := 'Arquivos' + ExtractFileExt(edUrl.Text) + '|*' + ExtractFileExt(edUrl.Text);
  SaveDialog.FileName := 'Arquivo';

  if SaveDialog.Execute then
    begin
      edDestino.Text := SaveDialog.FileName + ExtractFileExt(edUrl.Text);
    end;
end;

procedure TMainForm.CarregarDadosNaTela(ResultadoDownload: TDownloadRecord);
begin
  if ResultadoDownload.Status = stDownloading then
    EnableComponents(False);

  lbPercentual.Caption := FormatFloat('0 %', ResultadoDownload.ProgressPercentage);
  lbKiloBytes.Caption := FormatFloat('0.000 KBs', ResultadoDownload.ProgressKbytes);

  pbProgresso.Visible := True;
  lbPercentual.Visible := True;
  lbKiloBytes.Visible := True;

  pbProgresso.Max := ResultadoDownload.ProgressoMaximo;
  pbProgresso.Position := ResultadoDownload.Progress - 20;
end;

{******************************************************}
{ Define tamanhos minimos de altura e largura no form  }
{******************************************************}
procedure TMainForm.WMGetMinMaxInfo(var MSG: TMessage);
begin
  inherited;
  with PMinMaxInfo(MSG.lparam)^ do
  begin
    ptMinTRackSize.X := 650;
    ptMinTRackSize.Y := 400;
  end;
end;

end.
