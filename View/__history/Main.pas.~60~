//procedure TMainForm.CarregarDadosNaTela(DownloadRecord: TDownloadRecord);
procedure TMainForm.CarregarDadosNaTela(DownloadRecord: TDownload);
begin
  if DownloadRecord.Status = TDownloadStatus.Downloading then
    EnableComponents(False);

  lbPercentual.Caption := FormatFloat('0 %', DownloadRecord.ProgressPercentage);
  lbKiloBytes.Caption := FormatFloat('0.000 KBs', DownloadRecord.ProgressKbytes);
  pbProgresso.Visible := True;
  lbPercentual.Visible := True;
  lbKiloBytes.Visible := True;
//  pbProgresso.Max := DownloadRecord.ProgressoMaximo;
  pbProgresso.Max := DownloadRecord.ProgressoMax;
  pbProgresso.Position := DownloadRecord.Progress - 20;
end;

function TMainForm.GetDefaultDownloadFolder: String;
var path: String;
begin
  // Primeiramente atribui a variável o diretório padrão de download.
  path := System.IOUtils.TPath.GetDownloadsPath;
  // Caso a variável esteja vazia, então atribui-se a variável, a pasta temporária do Windows.
  if path.IsEmpty then
    path := System.IOUtils.TPath.GetTempPath;
  result := path;
end;

