//procedure TMainForm.Atualizar(DownloadRecord: TDownloadRecord);
procedure TMainForm.Atualizar(DownloadRecord: TDownload);
begin
  case DownloadRecord.Status of
    TDownloadStatus.Succeeded: FinalizarComSucesso;
    TDownloadStatus.Finished: FinalizarComErro(DownloadRecord);
    TDownloadStatus.Downloading: CarregarDadosNaTela(DownloadRecord);
  end;
end;

procedure TMainForm.FinalizarComSucesso;
begin
  MessageBox(0, PChar('Download realizado com sucesso'), PChar('Atenção'), MB_ICONINFORMATION or MB_OK);
  EnableComponents(True);
end;

//procedure TMainForm.FinalizarComErro(DownloadRecord: TDownloadRecord);
procedure TMainForm.FinalizarComErro(DownloadRecord: TDownload);
begin
  ReiniciarControles;
//  ShowMessage('Processo Cancelado!' + sLineBreak + ResultadoDownload.MsgErro);
  MessageBox(0, PChar('Problema ao realizar o download'+#13+#10+ DownloadRecord.ErrorMessage), PChar('Atenção'), MB_ICONERROR or MB_OK);
end;

//procedure TMainForm.FinalizadoPeloUsuario(ResultadoDownload: TDownloadRecord);
procedure TMainForm.FinalizadoPeloUsuario(ResultadoDownload: TDownload);
begin
  ReiniciarControles;
  ShowMessage('Processo Cancelado Pelo Usuário!');
  EnableComponents(True);
end;

