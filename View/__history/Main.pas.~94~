end;

procedure TMainForm.FinalizarComSucesso;
begin
  MessageBox(0, PChar('Download realizado com sucesso'), PChar('Atenção'), MB_ICONINFORMATION or MB_OK or MB_SYSTEMMODAL);

  EnableComponents(True);
end;

procedure TMainForm.FinalizarComErro(Download: TDownload);
begin
  StartFormObjects;

  MessageBox(0, PChar('Problema ao realizar o download'+#13+#10+ Download.ErrorMessage), PChar('Atenção'), MB_ICONERROR or MB_OK or MB_SYSTEMMODAL);
end;

procedure TMainForm.EnableComponents(enable: Boolean);
begin
  btIniciar.Enabled := enable;
  btParar.Enabled := not enable;
end;

procedure TMainForm.EndProcess(Download: TDownload);
begin
  case Download.Status of
    TDownloadStatus.Succeeded:
       begin
         MessageBox(0, PChar('Download realizado com sucesso'), PChar('Atenção'), MB_ICONINFORMATION or MB_OK or MB_SYSTEMMODAL);

         EnableComponents(True);
       end;

    TDownloadStatus.Error:
      begin
        StartFormObjects;

        MessageBox(0, PChar('Problema ao realizar o download'+#13+#10+ Download.ErrorMessage), PChar('Atenção'), MB_ICONERROR or MB_OK or MB_SYSTEMMODAL);
      end;

    TDownloadStatus.Downloading:
      begin
        StartFormObjects;

        MessageBox(0, PChar('Download interrompido pelo usuário'), PChar('Atenção'), MB_ICONERROR or MB_OK or MB_SYSTEMMODAL);
        EnableComponents(True);
      end;
  end;
end;

