var selDir: String;
begin
  SaveDialog.Filter := 'Arquivos' + ExtractFileExt(edtURL.Text) + '|*' + ExtractFileExt(edtURL.Text);
  SaveDialog.FileName := 'Arquivo';

  if SaveDialog.Execute then
    begin
      edtDestino.Text := SaveDialog.FileName + ExtractFileExt(edtURL.Text);
