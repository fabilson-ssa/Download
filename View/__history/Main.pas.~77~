{ TMainForm }
procedure TMainForm.FormCreate(Sender: TObject);
begin
  // Define o arquivo default para o download.
  edURL.Text := url_default_05mb;

  // Definie o diretório default para o download.
  edPastaPadrao.Text := GetDefaultDownloadFolder;

  // Criação do objeto responsável pelo gerenciamento do download
  HTTPRequest := TControllerHTTPRequest.New;

  // Coloca o próprio formulária na lista de objetos "observáveis".
  HTTPRequest.AddObserver(Self);
end;

procedure TMainForm.FormClose(Sender: TObject; var Action: TCloseAction);
begin
  // Antes de finalizar, verifica se ainda existe algum download em andamento.
  if HTTPRequest.IsDownloading then
    begin
      // Verifica se o usuário deseja realmente interromper o download.
      if MessageBox(0, PChar('Ainda existe download em andamento.'+#13+#10+'Confirma a interrupção?'), PChar('Atenção'), MB_ICONQUESTION or MB_YESNO or MB_SYSTEMMODAL) = mrYes then
        begin
          btParar.Click;
        end
      else
        Abort;
    end;
end;

procedure TMainForm.btIniciarClick(Sender: TObject);
var file_name: String;
begin
  // Armazena em variável o nome do aruqivo, segundo passado na URL
  file_name := System.IOUtils.TPath.GetFileName(edURL.Text);

  edDestino.Text := System.IOUtils.TPath.Combine(edDestino.Text, file_name);

  btIniciar.Enabled := False;
  pbProgresso.Visible := True;

  // Inicializa o download do arquivo.
  HTTPRequest.StartDownload(edURL.Text, edDestino.Text);
end;

procedure TMainForm.btPararClick(Sender: TObject);
begin
  HTTPRequest.StopDownload;

  ReiniciarControles;
  ShowMessage('Processo Cancelado Pelo Usuário!');
  EnableComponents(True);
end;

procedure TMainForm.NotifyDownload(Download: TDownload);
begin
  case Download.Status of
    TDownloadStatus.Succeeded: FinalizarComSucesso;
    TDownloadStatus.Error: FinalizarComErro(Download);
    TDownloadStatus.Downloading: UpdateForm(Download);
  end;
end;

procedure TMainForm.FinalizarComSucesso;
begin
  MessageBox(0, PChar('Download realizado com sucesso'), PChar('Atenção'), MB_ICONINFORMATION or MB_OK);
  EnableComponents(True);
end;

procedure TMainForm.FinalizarComErro(Download: TDownload);
begin
  ReiniciarControles;

  MessageBox(0, PChar('Problema ao realizar o download'+#13+#10+ Download.ErrorMessage), PChar('Atenção'), MB_ICONERROR or MB_OK);
end;

procedure TMainForm.EnableComponents(enable: Boolean);
begin
  btIniciar.Enabled := enable;
  btParar.Enabled := not enable;
end;

procedure TMainForm.EndProcess(Download: TDownload);
begin
  case Download.Status of
    TDownloadStatus.Succeeded:
       begin
         MessageBox(0, PChar('Download realizado com sucesso'), PChar('Atenção'), MB_ICONINFORMATION or MB_OK);

         EnableComponents(True);
       end;

    TDownloadStatus.Error:
      begin
        ReiniciarControles;

        MessageBox(0, PChar('Problema ao realizar o download'+#13+#10+ Download.ErrorMessage), PChar('Atenção'), MB_ICONERROR or MB_OK);
      end;

    TDownloadStatus.Downloading:
      begin
        ReiniciarControles;

        MessageBox(0, PChar('Download interrompido pelo usuário'), PChar('Atenção'), MB_ICONERROR or MB_OK);
        EnableComponents(True);
      end;
  end;
end;

