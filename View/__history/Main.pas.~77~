procedure TMainForm.UpdateForm(Download: TDownload);
begin
  if Download.Status = TDownloadStatus.Downloading then
    EnableComponents(False);

  lbPercentual.Visible := True;
  lbPercentual.Caption := FormatFloat('0 %', Download.ProgressPercentage);

  lbKiloBytes.Visible := True;
  lbKiloBytes.Caption := FormatFloat('0.000 KBs', Download.ProgressKbytes);

  pbProgresso.Visible := True;
  pbProgresso.Max := Download.ProgressMax;
  pbProgresso.Position := Download.Progress - 20;
end;

function TMainForm.GetDefaultDownloadFolder: String;
var path: String;
begin
  // Primeiramente atribui a variável o diretório padrão de download.
  path := System.IOUtils.TPath.GetDownloadsPath;
  // Caso a variável esteja vazia, então atribui-se a variável, a pasta temporária do Windows.
  if path.IsEmpty then
    path := System.IOUtils.TPath.GetTempPath;
  result := path;
end;

