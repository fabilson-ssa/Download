unit Utils.Download;

interface

uses Math,
     System.IOUtils,
     System.Generics.Collections, System.Generics.Defaults;

type

  TWindowsHelper = record
    class function GetDefaultDownloadFolder: String; static;
  end;

  TMathHelper = record
    class function ConvertBytes(Bytes: Int64): String; static;

    // Método responsável por retonar o percentual do valor X sobre o valor Y
    // O intValorAtual é qual poorcentagem de intValorMaximo
    class function Percentage(x, y: real): real; static;
  end;

implementation

uses
  System.SysUtils, System.RTLConsts, System.RTTI;

{ TMathHelper }

class function TMathHelper.ConvertBytes(Bytes: Int64): String;
const Description: Array [0 .. 8] of String = ('Bytes', 'KB', 'MB', 'GB', 'TB', 'PB', 'EB', 'ZB', 'YB');
var i: Integer;
    f: Double;
begin
  i := 0;

  while Bytes > Power(1024, i + 1) do
    Inc(i);

  f := Bytes / IntPower(1024, i);
//  Result := FormatFloat('###0.##', f) + ' ' + Description[i];
//  Result := floattostrf(f, ffNumber, 3, 2) + ' ' + Description[i];

  Result := Format('%.2n', [f]) + ' ' + Description[i];
end;

class function TMathHelper.Percentage(x, y: real): real;
begin
{
   Ex:  O valor 2560 e qual porcentagem de 5120?
        x = 2560
        y = 5120
        resposta = (x / y) * 100
        resposta = (2560 / 5120) * 100
        resposta =  50
        Conclusão: 2560 representa 50% de 5120
}
  result :=  (x / y) * 100;
end;

{ TWindowsHelper }

class function TWindowsHelper.GetDefaultDownloadFolder: String;
var path: String;
begin
  // Primeiramente atribui a variável o diretório padrão de download.
  path := System.IOUtils.TPath.GetDownloadsPath;

  // Caso a variável esteja vazia, então atribui-se a variável, a pasta temporária do Windows.
  if path.IsEmpty then
    path := System.IOUtils.TPath.GetTempPath;

  result := path;
end;

end.
